{
  "scripts": {
    "dev": "vike dev --host 0.0.0.0",
    "build:seed": "esbuild seed/seed.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/seed/seed.mjs --alias:@=./",
    "build": "vike build && pnpm build:seed",
    "preview": "vike build && vike preview",
    "prod": "pnpm build && node ./dist/server/index.mjs",
