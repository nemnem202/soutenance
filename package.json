    "test:coverage": "vitest run --coverage  --watch",
    "lint": "biome lint --write .",
    "format": "biome check --write --unsafe .",
    "format:check": "biome check .",
    "check": "biome check --write .",
    "check:ci": "biome ci . && tsc --noEmit",
